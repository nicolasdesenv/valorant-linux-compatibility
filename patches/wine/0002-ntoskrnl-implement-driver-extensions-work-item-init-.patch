+
+#define EX_RUNDOWN_ACTIVE 1
+
+typedef struct _EX_RUNDOWN_REF
+{
+    ULONG_PTR Count;
+} EX_RUNDOWN_REF, *PEX_RUNDOWN_REF, *PEX_RUNDOWN_REF_CACHE_AWARE;
+
+DEFINE_FASTCALL1_WRAPPER(ExInitializeRundownProtection)
+void FASTCALL ExInitializeRundownProtection( PEX_RUNDOWN_REF ref )
+{
+    TRACE( "ref %p.\n", ref );
+    InterlockedExchangePointer( (void **)&ref->Count, 0 );
+}
+
+DEFINE_FASTCALL1_WRAPPER(ExReInitializeRundownProtection)
+void FASTCALL ExReInitializeRundownProtection( PEX_RUNDOWN_REF ref )
+{
+    TRACE( "ref %p.\n", ref );
+    InterlockedExchangePointer( (void **)&ref->Count, 0 );
+}
+
+DEFINE_FASTCALL1_WRAPPER(ExRundownCompleted)
+void FASTCALL ExRundownCompleted( PEX_RUNDOWN_REF ref )
+{
+    TRACE( "ref %p.\n", ref );
+    InterlockedExchangePointer( (void **)&ref->Count, (void *)EX_RUNDOWN_ACTIVE );
+}
+
+DEFINE_FASTCALL_WRAPPER(ExAcquireRundownProtectionEx, 8)
+BOOLEAN FASTCALL ExAcquireRundownProtectionEx( PEX_RUNDOWN_REF ref, ULONG count )
+{
+    ULONG_PTR cur, next;
+
+    TRACE( "ref %p, count %lu.\n", ref, count );
+
+    for (;;)
+    {
+        cur = ref->Count;
+        if (cur & EX_RUNDOWN_ACTIVE) return FALSE;
+        next = cur + ((ULONG_PTR)count << 1);
+        if ((ULONG_PTR)InterlockedCompareExchangePointer( (void **)&ref->Count,
+                (void *)next, (void *)cur ) == cur)
+            return TRUE;
+    }
+}
+
+DEFINE_FASTCALL1_WRAPPER(ExAcquireRundownProtection)
+BOOLEAN FASTCALL ExAcquireRundownProtection( PEX_RUNDOWN_REF ref )
+{
+    return ExAcquireRundownProtectionEx( ref, 1 );
+}
+
+DEFINE_FASTCALL_WRAPPER(ExReleaseRundownProtectionEx, 8)
+void FASTCALL ExReleaseRundownProtectionEx( PEX_RUNDOWN_REF ref, ULONG count )
+{
+    ULONG_PTR cur, next;
+
+    TRACE( "ref %p, count %lu.\n", ref, count );
+
+    for (;;)
+    {
+        cur = ref->Count;
+        next = cur - ((ULONG_PTR)count << 1);
+        if ((ULONG_PTR)InterlockedCompareExchangePointer( (void **)&ref->Count,
+                (void *)next, (void *)cur ) == cur)
+            return;
+    }
+}
+
+DEFINE_FASTCALL1_WRAPPER(ExReleaseRundownProtection)
+void FASTCALL ExReleaseRundownProtection( PEX_RUNDOWN_REF ref )
+{
+    ExReleaseRundownProtectionEx( ref, 1 );
+}
+
+DEFINE_FASTCALL1_WRAPPER(ExWaitForRundownProtectionRelease)
+void FASTCALL ExWaitForRundownProtectionRelease( PEX_RUNDOWN_REF ref )
+{
+    ULONG_PTR cur;
+
+    TRACE( "ref %p.\n", ref );
+
+    for (;;)
+    {
+        cur = ref->Count;
+        if (cur & EX_RUNDOWN_ACTIVE) break;
+        if ((ULONG_PTR)InterlockedCompareExchangePointer( (void **)&ref->Count,
+                (void *)(cur | EX_RUNDOWN_ACTIVE), (void *)cur ) == cur)
+            break;
+    }
+
+    while (ref->Count != EX_RUNDOWN_ACTIVE)
+        YieldProcessor();
+}
+
+PEX_RUNDOWN_REF_CACHE_AWARE WINAPI ExAllocateCacheAwareRundownProtection( POOL_TYPE pool_type, ULONG tag )
+{
+    PEX_RUNDOWN_REF_CACHE_AWARE ref;
+
+    TRACE( "pool_type %u, tag %#lx.\n", pool_type, tag );
+
+    if (!(ref = ExAllocatePoolWithTag( pool_type, sizeof(*ref), tag ))) return NULL;
+    ExInitializeRundownProtection( ref );
+    return ref;
+}
+
+void WINAPI ExFreeCacheAwareRundownProtection( PEX_RUNDOWN_REF_CACHE_AWARE ref )
+{
+    TRACE( "ref %p.\n", ref );
+    ExFreePool( ref );
+}
+
+DEFINE_FASTCALL_WRAPPER(ExAcquireRundownProtectionCacheAwareEx, 8)
+BOOLEAN FASTCALL ExAcquireRundownProtectionCacheAwareEx( PEX_RUNDOWN_REF_CACHE_AWARE ref, ULONG count )
+{
+    return ExAcquireRundownProtectionEx( ref, count );
+}
+
+DEFINE_FASTCALL_WRAPPER(ExReleaseRundownProtectionCacheAwareEx, 8)
+void FASTCALL ExReleaseRundownProtectionCacheAwareEx( PEX_RUNDOWN_REF_CACHE_AWARE ref, ULONG count )
+{
+    ExReleaseRundownProtectionEx( ref, count );
+}
+
+DEFINE_FASTCALL1_WRAPPER(ExWaitForRundownProtectionReleaseCacheAware)
+void FASTCALL ExWaitForRundownProtectionReleaseCacheAware( PEX_RUNDOWN_REF_CACHE_AWARE ref )
+{
+    ExWaitForRundownProtectionRelease( ref );
+}
+
+void WINAPI ExInitializePushLock( PULONG_PTR push_lock )
+{
+    TRACE( "push_lock %p.\n", push_lock );
+    *push_lock = 0;
+}
+
+void WINAPI ExAcquirePushLockExclusiveEx( PULONG_PTR push_lock, ULONG flags )
+{
+    TRACE( "push_lock %p, flags %#lx.\n", push_lock, flags );
+    AcquireSRWLockExclusive( (SRWLOCK *)push_lock );
+}
+
+void WINAPI ExReleasePushLockExclusiveEx( PULONG_PTR push_lock, ULONG flags )
+{
+    TRACE( "push_lock %p, flags %#lx.\n", push_lock, flags );
+    ReleaseSRWLockExclusive( (SRWLOCK *)push_lock );
+}
