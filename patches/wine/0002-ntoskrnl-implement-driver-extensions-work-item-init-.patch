+    if (!DriverObject) return NULL;
+    driver = CONTAINING_RECORD( DriverObject, struct wine_driver, driver_obj );
+
+    EnterCriticalSection( &drivers_cs );
+    LIST_FOR_EACH_ENTRY( cur, &driver->extensions, struct driver_obj_extension, entry )
+    {
+        if (cur->id == ClientIdentificationAddress)
+        {
+            ret = cur + 1;
+            break;
+        }
+    }
+    LeaveCriticalSection( &drivers_cs );
+
+    return ret;
 }
 
 
